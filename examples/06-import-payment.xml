<!-- Import ONE Payment voucher: money OUT of the bank.
     Dr the expense/party, Cr the bank. (Sign: Dr = ISDEEMEDPOSITIVE Yes / negative AMOUNT.)
     curl.exe -s -X POST -H "Content-Type: text/xml" --data-binary @06-import-payment.xml http://localhost:9000 -->
<ENVELOPE>
 <HEADER><TALLYREQUEST>Import Data</TALLYREQUEST></HEADER>
 <BODY><IMPORTDATA>
  <REQUESTDESC><REPORTNAME>Vouchers</REPORTNAME>
   <STATICVARIABLES><SVCURRENTCOMPANY>YOUR COMPANY NAME</SVCURRENTCOMPANY></STATICVARIABLES>
  </REQUESTDESC>
  <REQUESTDATA><TALLYMESSAGE xmlns:UDF="TallyUDF">
   <VOUCHER REMOTEID="DEMO-PAY-20260401-001" VCHTYPE="Payment" ACTION="Create" OBJVIEW="Accounting Voucher View">
    <DATE>20260401</DATE><EFFECTIVEDATE>20260401</EFFECTIVEDATE>
    <VOUCHERTYPENAME>Payment</VOUCHERTYPENAME><NARRATION>Office rent April</NARRATION>
    <ALLLEDGERENTRIES.LIST><LEDGERNAME>Rent Paid</LEDGERNAME><ISDEEMEDPOSITIVE>Yes</ISDEEMEDPOSITIVE><AMOUNT>-50000.00</AMOUNT></ALLLEDGERENTRIES.LIST>
    <ALLLEDGERENTRIES.LIST><LEDGERNAME>Bank Ledger Name</LEDGERNAME><ISDEEMEDPOSITIVE>No</ISDEEMEDPOSITIVE><AMOUNT>50000.00</AMOUNT></ALLLEDGERENTRIES.LIST>
   </VOUCHER>
  </TALLYMESSAGE></REQUESTDATA>
 </IMPORTDATA></BODY>
</ENVELOPE>
