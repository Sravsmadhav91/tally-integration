<!-- Read: full Voucher Register (Day Book) for a date range. Use this (not a Voucher Collection)
     to get TRUE narrations, bank allocations, and inventory entries.
     NOTE: the date filter is sometimes ignored (returns whole FY) - re-filter in your code. -->
<ENVELOPE>
 <HEADER>
  <VERSION>1</VERSION>
  <TALLYREQUEST>Export</TALLYREQUEST>
  <TYPE>Data</TYPE>
  <ID>Voucher Register</ID>
 </HEADER>
 <BODY>
  <DESC>
   <STATICVARIABLES>
    <SVCURRENTCOMPANY>YOUR COMPANY NAME</SVCURRENTCOMPANY>
    <SVFROMDATE TYPE="Date">20250401</SVFROMDATE>
    <SVTODATE TYPE="Date">20260331</SVTODATE>
    <SVEXPORTFORMAT>$$SysName:XML</SVEXPORTFORMAT>
   </STATICVARIABLES>
  </DESC>
 </BODY>
</ENVELOPE>
