<!-- Import ONE Contra voucher: bank-to-bank transfer (or bank<->cash).
     Dr destination bank (money in), Cr source bank (money out).
     curl.exe -s -X POST -H "Content-Type: text/xml" --data-binary @07-import-contra.xml http://localhost:9000 -->
<ENVELOPE>
 <HEADER><TALLYREQUEST>Import Data</TALLYREQUEST></HEADER>
 <BODY><IMPORTDATA>
  <REQUESTDESC><REPORTNAME>Vouchers</REPORTNAME>
   <STATICVARIABLES><SVCURRENTCOMPANY>YOUR COMPANY NAME</SVCURRENTCOMPANY></STATICVARIABLES>
  </REQUESTDESC>
  <REQUESTDATA><TALLYMESSAGE xmlns:UDF="TallyUDF">
   <VOUCHER REMOTEID="DEMO-CON-20260401-001" VCHTYPE="Contra" ACTION="Create" OBJVIEW="Accounting Voucher View">
    <DATE>20260401</DATE><EFFECTIVEDATE>20260401</EFFECTIVEDATE>
    <VOUCHERTYPENAME>Contra</VOUCHERTYPENAME><NARRATION>FUND TRANSFER</NARRATION>
    <ALLLEDGERENTRIES.LIST><LEDGERNAME>Bank A - destination</LEDGERNAME><ISDEEMEDPOSITIVE>Yes</ISDEEMEDPOSITIVE><AMOUNT>-100000.00</AMOUNT></ALLLEDGERENTRIES.LIST>
    <ALLLEDGERENTRIES.LIST><LEDGERNAME>Bank B - source</LEDGERNAME><ISDEEMEDPOSITIVE>No</ISDEEMEDPOSITIVE><AMOUNT>100000.00</AMOUNT></ALLLEDGERENTRIES.LIST>
   </VOUCHER>
  </TALLYMESSAGE></REQUESTDATA>
 </IMPORTDATA></BODY>
</ENVELOPE>
