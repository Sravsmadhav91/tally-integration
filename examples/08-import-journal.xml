<!-- Import ONE Journal voucher: non-cash adjustment (e.g. year-end accrual).
     Example: recognise rent expense against two landlord payables.
     curl.exe -s -X POST -H "Content-Type: text/xml" --data-binary @08-import-journal.xml http://localhost:9000 -->
<ENVELOPE>
 <HEADER><TALLYREQUEST>Import Data</TALLYREQUEST></HEADER>
 <BODY><IMPORTDATA>
  <REQUESTDESC><REPORTNAME>Vouchers</REPORTNAME>
   <STATICVARIABLES><SVCURRENTCOMPANY>YOUR COMPANY NAME</SVCURRENTCOMPANY></STATICVARIABLES>
  </REQUESTDESC>
  <REQUESTDATA><TALLYMESSAGE xmlns:UDF="TallyUDF">
   <VOUCHER REMOTEID="DEMO-JRN-20260331-001" VCHTYPE="Journal" ACTION="Create" OBJVIEW="Accounting Voucher View">
    <DATE>20260331</DATE><EFFECTIVEDATE>20260331</EFFECTIVEDATE>
    <VOUCHERTYPENAME>Journal</VOUCHERTYPENAME><NARRATION>Being year-end accrual</NARRATION>
    <ALLLEDGERENTRIES.LIST><LEDGERNAME>Some Expense</LEDGERNAME><ISDEEMEDPOSITIVE>Yes</ISDEEMEDPOSITIVE><AMOUNT>-12000.00</AMOUNT></ALLLEDGERENTRIES.LIST>
    <ALLLEDGERENTRIES.LIST><LEDGERNAME>Some Payable</LEDGERNAME><ISDEEMEDPOSITIVE>No</ISDEEMEDPOSITIVE><AMOUNT>12000.00</AMOUNT></ALLLEDGERENTRIES.LIST>
   </VOUCHER>
  </TALLYMESSAGE></REQUESTDATA>
 </IMPORTDATA></BODY>
</ENVELOPE>
